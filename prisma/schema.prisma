// PrepWell NG — Database Schema
// Run: npx prisma migrate dev --name init
// Run: npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────

/// STUDENT and TEACHER only. ADMIN is retained because Postgres has no
/// DROP VALUE, but it is never assigned — admins live in the Admin model.
enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum ClassLevel {
  SS1
  SS2
  SS3
}

enum Track {
  SCIENCE
  ARTS
  COMMERCIAL
}

enum Term {
  FIRST
  SECOND
  THIRD
}

enum ExamType {
  WAEC
  JAMB
  NECO
  CUSTOM
}

enum QuestionType {
  OBJECTIVE
  THEORY
  FILL_IN_BLANK
}

enum Difficulty {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum AssessmentType {
  TOPIC_QUIZ
  SUBJECT_TEST
  PAST_PAPER
  MOCK_EXAM
  CBT_PRACTICE
  CUSTOM
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  TIMED_OUT
}

enum PlanItemActivity {
  LESSON
  PRACTICE
  REVISION
  MOCK_EXAM
  PAST_QUESTIONS
}

enum PlanItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum TrackCategory {
  CORE
  SCIENCE
  ARTS
  COMMERCIAL
  VOCATIONAL
}

enum SchoolType {
  PUBLIC
  PRIVATE
}

enum MasteryLevel {
  WEAK
  DEVELOPING
  COMPETENT
  STRONG
}

enum FlashcardType {
  DEFINITION
  FORMULA
  IMAGE
  DIAGRAM
  FILL_IN_BLANK
  COMPARE_CONTRAST
  TRUE_FALSE
  SCENARIO
  PROCESS
}

enum FlashcardSource {
  AUTHORED
  LESSON
  AI
}

enum FlashcardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum EdgeKind {
  PREREQUISITE
  STRONG_RELATED
  RELATED
}

enum LearningEventKind {
  QUESTION_ANSWERED
  QUIZ_ABANDONED
  LESSON_BLOCK_COMPLETED
  LESSON_COMPLETED
  CARD_REVIEWED
  PRETEST_PASSED
}

// ─── User & Auth ──────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  email         String?     @unique
  phone         String?     @unique
  emailVerified DateTime?
  passwordHash  String?
  firstName     String
  lastName      String
  image         String?
  role          Role        @default(STUDENT)
  classLevel    ClassLevel?
  track         Track?
  state         String?
  schoolId      String?
  school        School?     @relation(fields: [schoolId], references: [id])

  // Relations
  progress     StudentProgress[]
  attempts     AssessmentAttempt[]
  studyPlans   StudyPlan[]
  metrics      PerformanceMetric[]
  achievements StudentAchievement[]
  accounts     Account[]
  sessions     Session[]

  // Learning Evidence Layer (see docs/superpowers/specs/2026-08-11-learning-evidence-layer-design.md)
  learningEvents LearningEvent[]
  topicMastery   TopicMastery[]

  // Flashcards (see docs/superpowers/specs/2026-08-01-flashcards-design.md)
  flashcardReviews     FlashcardReview[]
  flashcardReviewLogs  FlashcardReviewLog[]
  flashcardEnrollments FlashcardEnrollment[]
  flashcardDecks       FlashcardDeck[]       @relation("FlashcardDeckAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classLevel, track])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model School {
  id        String     @id @default(cuid())
  name      String
  state     String
  lga       String?
  type      SchoolType @default(PUBLIC)
  users     User[]
  createdAt DateTime   @default(now())

  @@index([state])
}

// ─── Curriculum & Content ─────────────────────────────────

model Subject {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  code          String        @unique
  description   String
  iconUrl       String?
  isWaec        Boolean       @default(false)
  isJamb        Boolean       @default(false)
  isNeco        Boolean       @default(false)
  trackCategory TrackCategory

  curriculumLevels CurriculumLevel[]
  topics           Topic[]
  questions        Question[]
  assessments      Assessment[]
  progress         StudentProgress[]
  metrics          PerformanceMetric[]
  studyPlanItems   StudyPlanItem[]
  resources        SubjectResource[]
  flashcardDecks   FlashcardDeck[]

  createdAt DateTime @default(now())
}

model SubjectResource {
  id           String  @id @default(cuid())
  subjectId    String
  subject      Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  resourceType String // textbook, video, pdf, link, worksheet, past_paper
  url          String
  author       String?
  isFree       Boolean @default(true)
  orderIndex   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

model CurriculumLevel {
  id          String     @id @default(cuid())
  subjectId   String
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel  ClassLevel
  term        Term
  description String?

  topics Topic[]

  @@unique([subjectId, classLevel, term])
  @@index([classLevel])
}

model Topic {
  id                  String          @id @default(cuid())
  subjectId           String
  subject             Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  curriculumLevelId   String
  curriculumLevel     CurriculumLevel @relation(fields: [curriculumLevelId], references: [id], onDelete: Cascade)
  title               String
  slug                String
  description         String?
  orderIndex          Int
  estimatedMinutes    Int             @default(45)
  prerequisiteTopicId String?
  prerequisiteTopic   Topic?          @relation("PrerequisiteChain", fields: [prerequisiteTopicId], references: [id])
  dependentTopics     Topic[]         @relation("PrerequisiteChain")
  waecWeight          Float           @default(0)
  jambWeight          Float           @default(0)

  subtopics      Subtopic[]
  questions      Question[]
  progress       StudentProgress[]
  metrics        PerformanceMetric[]
  studyPlanItems StudyPlanItem[]
  flashcardDecks FlashcardDeck[]

  // Learning Path Engine (see docs/superpowers/specs/2026-08-02-learning-path-engine-design.md)
  prereqEdges    TopicEdge[] @relation("GraphDependent")
  dependentEdges TopicEdge[] @relation("GraphPrereq")

  // Learning Evidence Layer (see docs/superpowers/specs/2026-08-11-learning-evidence-layer-design.md)
  topicMastery TopicMastery[]

  @@unique([subjectId, slug])
  @@index([subjectId, orderIndex])
  @@index([curriculumLevelId])
}

model TopicEdge {
  id            String   @id @default(cuid())
  prereqTopicId String
  prereqTopic   Topic    @relation("GraphPrereq", fields: [prereqTopicId], references: [id], onDelete: Cascade)
  topicId       String
  topic         Topic    @relation("GraphDependent", fields: [topicId], references: [id], onDelete: Cascade)
  kind          EdgeKind @default(PREREQUISITE)
  strength      Float    @default(1) // fraction of GATE a prereq must reach to unlock
  rationale     String? // author-facing "why", shown in the UI

  @@unique([prereqTopicId, topicId])
  @@index([topicId])
}

model Subtopic {
  id          String  @id @default(cuid())
  topicId     String
  topic       Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  description String?
  orderIndex  Int

  lessons Lesson[]

  @@index([topicId, orderIndex])
}

model Lesson {
  id               String     @id @default(cuid())
  subtopicId       String
  subtopic         Subtopic   @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  title            String
  content          String     @db.Text // MDX content (fallback when blocks is empty)
  summary          String?    @db.Text
  keyPoints        Json? // ["point1", "point2", ...]
  workedExamples   Json? // [{ problem: "...", solution: "..." }, ...]
  difficulty       Difficulty @default(INTERMEDIATE)
  estimatedMinutes Int        @default(20)
  createdBy        String?

  // Lesson Engine (see docs/superpowers/specs/2026-08-01-lesson-engine-design.md)
  // blocks is the structured lesson: concept/diagram/example/tip/mistake/mnemonic/check
  blocks          Json? // LessonBlock[]
  examTips        Json? // [{ text, examType? }]
  mnemonics       Json? // [{ phrase, encoded[] }]
  knowledgeChecks Json? // [{ id, question, options, answer, explanation, afterCard }]
  prerequisites   Json? // [{ topicTitle? | lessonTitle?, reason }]
  passMarkPercent Int   @default(60)
  practiceCount   Int   @default(7)
  revisionDays    Json? // [1, 3, 7, 14]

  progress       StudentProgress[]
  resources      LessonResource[]
  flashcardDecks FlashcardDeck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subtopicId])
}

model LessonResource {
  id           String  @id @default(cuid())
  lessonId     String
  lesson       Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resourceType String // image, video, pdf, diagram
  url          String
  caption      String?
  orderIndex   Int     @default(0)
}

// ─── Question Bank ────────────────────────────────────────

model Question {
  id                  String       @id @default(cuid())
  subjectId           String
  subject             Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId             String?
  topic               Topic?       @relation(fields: [topicId], references: [id])
  examType            ExamType
  examYear            Int?
  questionNumber      Int?
  questionText        String       @db.Text
  questionImageUrl    String?
  questionType        QuestionType @default(OBJECTIVE)
  options             Json? // { "A": "...", "B": "...", "C": "...", "D": "..." }
  correctAnswer       String
  explanation         String       @db.Text
  explanationImageUrl String?
  difficulty          Difficulty   @default(INTERMEDIATE)
  marks               Int          @default(1)
  timeEstimateSeconds Int          @default(90)

  responses           QuestionResponse[]
  assessmentQuestions AssessmentQuestion[]

  createdAt DateTime @default(now())

  @@index([subjectId, topicId])
  @@index([examType, examYear])
  @@index([subjectId, difficulty])
  @@index([subjectId, examType, examYear])
  // Every quiz generation filters on questionType alongside the subject, so
  // without this the random pick scans the subject's whole bank.
  @@index([subjectId, questionType])
  @@index([subjectId, questionType, examType])
}

// ─── Assessments ──────────────────────────────────────────

model Assessment {
  id               String         @id @default(cuid())
  title            String
  description      String?
  assessmentType   AssessmentType
  subjectId        String?
  subject          Subject?       @relation(fields: [subjectId], references: [id])
  examType         ExamType?
  examYear         Int?
  timeLimitMinutes Int?
  totalMarks       Int
  passMarkPercent  Int            @default(50)

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  createdBy String?
  createdAt DateTime @default(now())

  @@index([assessmentType])
  @@index([subjectId, assessmentType])
}

model AssessmentQuestion {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])
  orderIndex   Int

  @@unique([assessmentId, questionId])
  @@index([assessmentId, orderIndex])
}

model AssessmentAttempt {
  id               String        @id @default(cuid())
  studentId        String
  student          User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId     String
  assessment       Assessment    @relation(fields: [assessmentId], references: [id])
  startedAt        DateTime      @default(now())
  completedAt      DateTime?
  timeSpentSeconds Int?
  score            Float?
  totalMarks       Int?
  percentage       Float?
  grade            String?
  status           AttemptStatus @default(IN_PROGRESS)
  /// How many times the student left the exam. Client-reported; see the spec.
  awayEvents       Int           @default(0)

  responses QuestionResponse[]

  @@index([studentId, assessmentId])
  @@index([studentId, status])
  // Dashboard, performance and streaks all read completed attempts newest-first.
  @@index([studentId, status, completedAt])
}

model QuestionResponse {
  id               String            @id @default(cuid())
  attemptId        String
  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question          @relation(fields: [questionId], references: [id])
  selectedAnswer   String?
  isCorrect        Boolean?
  timeSpentSeconds Int?
  flaggedForReview Boolean           @default(false)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  // The "questions this student has already seen" subquery in question-pool
  // probes by questionId before joining back to the attempt.
  @@index([questionId])
  // The performance page groups wrong answers by subject and topic.
  @@index([isCorrect])
}

// ─── Progress & Performance ───────────────────────────────

model StudentProgress {
  id                String         @id @default(cuid())
  studentId         String
  student           User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject        @relation(fields: [subjectId], references: [id])
  topicId           String?
  topic             Topic?         @relation(fields: [topicId], references: [id])
  lessonId          String?
  lesson            Lesson?        @relation(fields: [lessonId], references: [id])
  status            ProgressStatus @default(NOT_STARTED)
  completionPercent Float          @default(0)
  timeSpentMinutes  Int            @default(0)
  lastAccessedAt    DateTime?

  // Lesson Engine state
  checkpointData Json? // per-block state: visited / correct / attempts
  masteryScore   Float? // last computed 0..100
  revisionDueAt  DateTime? // next scheduled revision

  @@unique([studentId, subjectId, topicId, lessonId])
  @@index([studentId, subjectId])
  @@index([studentId, status])
}

model PerformanceMetric {
  id                     String       @id @default(cuid())
  studentId              String
  student                User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId              String
  subject                Subject      @relation(fields: [subjectId], references: [id])
  topicId                String?
  topic                  Topic?       @relation(fields: [topicId], references: [id])
  masteryLevel           MasteryLevel @default(WEAK)
  lastUpdated            DateTime     @default(now())

  // Learning Path Engine (see docs/superpowers/specs/2026-08-02-learning-path-engine-design.md)
  pretestPassedAt DateTime? // readiness pretest passed (≥80% on 5 questions)

  @@unique([studentId, subjectId, topicId])
  @@index([studentId, subjectId])
  @@index([studentId, masteryLevel])
}

// ─── Learning Evidence Layer ──────────────────────────────
// See docs/superpowers/specs/2026-08-11-learning-evidence-layer-design.md

/// Append-only record of what the student did. Never updated, never deleted
/// except by cascade. TopicMastery is a fold of this table.
model LearningEvent {
  seq        BigInt            @id @default(autoincrement())
  studentId  String
  student    User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  String
  topicId    String?
  kind       LearningEventKind
  correct    Boolean?
  /// 0..1 outcome for non-binary evidence (lesson mastery, review grade).
  score      Float?
  /// The authored difficulty label at the moment the question was answered.
  difficulty Difficulty?
  seconds    Int?
  /// questionId / lessonId / flashcardId — for audit, not for logic.
  sourceId   String?
  occurredAt DateTime          @default(now())

  @@index([studentId, topicId, seq])
  @@index([studentId, seq])
}

/// Decayed sufficient statistics per (student, topic) — a cache of the fold
/// over LearningEvent, not a second source of truth. Reset cursorSeq to 0 to
/// force a full replay.
model TopicMastery {
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  topicId   String
  topic     Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  accWeightedOutcome    Float @default(0)
  accWeightedMass       Float @default(0)
  lessonWeightedOutcome Float @default(0)
  lessonWeightedMass    Float @default(0)
  srsWeightedOutcome    Float @default(0)
  srsWeightedMass       Float @default(0)

  /// Raw event counts per channel. Never decayed — see ChannelStats in
  /// src/engines/learning/fold.ts.
  accObservations    Int @default(0)
  lessonObservations Int @default(0)
  srsObservations    Int @default(0)

  /// The instant the stored sums are decayed to.
  decayAnchor    DateTime
  /// Highest LearningEvent.seq already folded in.
  cursorSeq      BigInt    @default(0)
  /// Latest genuine-effort event. Lesson *access* never advances this.
  lastEffortAt   DateTime?
  /// Mirrors SCORING_VERSION in src/engines/learning/evidence.ts, which is the
  /// authority. A row whose version differs is refolded from cursor 0 on the
  /// next read, so bumping the constant is how a scoring change is rolled out.
  /// The default below is deliberately NOT kept in step: nothing but the store
  /// inserts these rows, and the store always writes the constant explicitly,
  /// so a stale default is inert — and changing it would cost a migration for
  /// no behavioural gain.
  scoringVersion Int       @default(1)
  updatedAt      DateTime  @updatedAt

  @@id([studentId, topicId])
  @@index([studentId, subjectId])
}

// ─── Study Planning ───────────────────────────────────────

model StudyPlan {
  id              String   @id @default(cuid())
  studentId       String
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetExam      ExamType
  targetDate      DateTime
  subjectIds      Json // String[] of subject IDs
  dailyStudyHours Float    @default(2)
  isActive        Boolean  @default(true)

  items StudyPlanItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, isActive])
}

model StudyPlanItem {
  id              String           @id @default(cuid())
  studyPlanId     String
  studyPlan       StudyPlan        @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  scheduledDate   DateTime         @db.Date
  subjectId       String
  subject         Subject          @relation(fields: [subjectId], references: [id])
  topicId         String?
  topic           Topic?           @relation(fields: [topicId], references: [id])
  activityType    PlanItemActivity
  durationMinutes Int
  status          PlanItemStatus   @default(PENDING)
  notes           String?

  @@index([studyPlanId, scheduledDate])
  @@index([studyPlanId, status])
}

// ─── Gamification ─────────────────────────────────────────

model Achievement {
  id            String  @id @default(cuid())
  title         String  @unique
  description   String
  iconUrl       String?
  criteriaType  String // e.g., "streak_days", "questions_answered", "subject_mastery"
  criteriaValue Int // e.g., 7 for 7-day streak

  students StudentAchievement[]
}

model StudentAchievement {
  id            String      @id @default(cuid())
  studentId     String
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now())

  @@unique([studentId, achievementId])
}

// ─── JAMB Subject Combinations Reference ──────────────────

model JambCombination {
  id                String  @id @default(cuid())
  courseOfStudy     String
  faculty           String
  requiredSubjects  Json // ["Physics", "Chemistry", "Mathematics"]
  alternateSubjects Json? // ["Biology OR Agricultural Science"]
  notes             String?

  @@index([faculty])
}

// ─── Flashcards (SRS) ──────────────────────────────────────
// See docs/superpowers/specs/2026-08-01-flashcards-design.md

model FlashcardDeck {
  id          String          @id @default(cuid())
  title       String
  slug        String?
  description String?
  source      FlashcardSource @default(AUTHORED)
  subjectId   String?
  subject     Subject?        @relation(fields: [subjectId], references: [id])
  topicId     String?
  topic       Topic?          @relation(fields: [topicId], references: [id])
  lessonId    String?
  lesson      Lesson?         @relation(fields: [lessonId], references: [id])
  createdBy   String?
  author      User?           @relation("FlashcardDeckAuthor", fields: [createdBy], references: [id])

  cards       Flashcard[]
  enrollments FlashcardEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, source])
  @@index([subjectId])
  @@index([topicId])
}

model Flashcard {
  id         String        @id @default(cuid())
  deckId     String
  deck       FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardType   FlashcardType
  prompt     String? // short front label for lists ("Mitochondrion")
  payload    Json // typed card body (authoring format in the spec)
  difficulty Difficulty    @default(INTERMEDIATE)
  tags       Json?
  orderIndex Int           @default(0)
  // id of the lesson block this card was generated from. Nullable: rows that
  // predate re-sync have no key (stamped on first re-sync), and AUTHORED decks
  // have no source block at all. Postgres does not collide nulls under a
  // unique index, so any number of them coexist in one deck.
  sourceKey  String?

  reviews   FlashcardReview[]
  reviewLog FlashcardReviewLog[]

  createdAt DateTime @default(now())

  @@unique([deckId, sourceKey])
  @@index([deckId, orderIndex])
}

model FlashcardReview {
  id             String         @id @default(cuid())
  studentId      String
  student        User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flashcardId    String
  flashcard      Flashcard      @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  state          FlashcardState @default(NEW)
  easeFactor     Float          @default(2.5)
  stability      Float          @default(0) // days
  difficulty     Float          @default(5) // 1..10, seeded from authored difficulty
  intervalDays   Float          @default(0)
  repetitions    Int            @default(0)
  lapses         Int            @default(0)
  retention      Float          @default(0) // predicted recall probability at scheduling (0..1)
  dueAt          DateTime
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, flashcardId])
  @@index([studentId, dueAt])
  @@index([studentId, state])
}

model FlashcardReviewLog {
  id             String       @id @default(cuid())
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flashcardId    String
  flashcard      Flashcard    @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  rating         ReviewRating
  responseTimeMs Int?
  scheduledDays  Float?
  objectiveCorrect Boolean?
  reviewedAt     DateTime     @default(now())

  @@index([studentId, reviewedAt])
  @@index([studentId, flashcardId, reviewedAt])
}

model FlashcardEnrollment {
  id        String        @id @default(cuid())
  studentId String
  student   User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  deckId    String
  deck      FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([studentId, deckId])
  @@index([deckId])
}

// ─── Admin ──────────────────────────────────────────────────

/// Admins are a separate identity from students — see
/// docs/superpowers/specs/2026-08-26-admin-identity-design.md.
/// No Account/Session relations: the admin auth instance uses the credentials
/// provider with a JWT strategy and never touches the Prisma adapter.
model Admin {
  id           String    @id @default(cuid())
  email        String?   @unique
  username     String?   @unique
  passwordHash String
  isOwner      Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdById   String?
  createdBy     Admin?  @relation("AdminCreator", fields: [createdById], references: [id])
  createdAdmins Admin[] @relation("AdminCreator")

  audits AdminAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAudit {
  id        String   @id @default(cuid())
  actorId   String
  actor     Admin    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String // "question.create" | "question.update" | "question.delete" | "question.import"
  entity    String // "Question"
  entityId  String?
  summary   String   @db.Text
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
